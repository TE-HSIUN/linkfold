generator client {
  provider = "prisma-client-js"
}

  datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
  }

model Link {
  id           Int      @id @default(autoincrement())
  shortCode    String   @unique
  originalUrl  String
  note         String?
  passwordHash String?
  createdAt    DateTime @default(now())
}
